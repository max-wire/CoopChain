ber\",\"type\":\"address\"}],\"name\":\"getRiskTier\",\"outputs\":[{\"internalType\":\"enum ICreditScore.RiskTier\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Maxwell Wire\",\"details\":\"Credit Score V1: - Membership duration (30%) - Savings behaviour (70%) - Repayment history: 0% (reserved for future versions) Monetary thresholds are denominated in 6-decimal USDC units for the current Arc Testnet deployment. The maximum credit score is 100 and is mapped to a corresponding risk tier ranging from VeryLow to VeryHigh.\",\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"coopVault\":\"Address of the CoopVault contract.\",\"savings\":\"Address of the Savings contract.\"}},\"getCreditProfile(address)\":{\"details\":\"Reverts if the member is inactive or does not exist.\",\"params\":{\"member\":\"Address of the cooperative member.\"},\"returns\":{\"_0\":\"The member's credit profile.\"}},\"getCreditScore(address)\":{\"details\":\"The returned value is between 0 and 100. Reverts if the member is inactive or does not exist.\",\"params\":{\"member\":\"Address of the cooperative member.\"},\"returns\":{\"_0\":\"The member's credit score.\"}},\"getRiskTier(address)\":{\"details\":\"Risk tiers are derived from the overall credit score. Reverts if the member is inactive or does not exist.\",\"params\":{\"member\":\"Address of the cooperative member.\"},\"returns\":{\"_0\":\"The member's risk classification.\"}}},\"title\":\"CreditScore\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"constructor\":{\"notice\":\"Deploys the CreditScore contract.\"},\"getCreditProfile(address)\":{\"notice\":\"Returns the complete credit profile of a member.\"},\"getCreditScore(address)\":{\"notice\":\"Returns the overall credit score of a member.\"},\"getRiskTier(address)\":{\"notice\":\"Returns the risk tier assigned to a member.\"}},\"notice\":\"Calculates the creditworthiness of cooperative members.\"