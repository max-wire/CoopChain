nt256\"}],\"name\":\"compoundInterest\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"interestEarned\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"totalAmount\",\"type\":\"uint256\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"principal\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"annualRateBps\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"periods\",\"type\":\"uint256\"}],\"name\":\"futureValue\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"futureValue_\",\"type\":\"uint256\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"futureValue_\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"annualRateBps\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"periods\",\"type\":\"uint256\"}],\"name\":\"presentValue\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"presentValue_\",\"type\":\"uint256\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"principal\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"annualRateBps\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"periods\",\"type\":\"uint256\"}],\"name\":\"simpleInterest\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"interestEarned\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"totalAmount\",\"type\":\"uint256\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Maxwell Wire\",\"details\":\"Monetary inputs and outputs use the native denomination of the underlying asset. For the current CoopChain deployment, this is 6-decimal USDC. Fixed-point mathematical calculations use 1e18 precision independently of the underlying asset's decimals.\",\"kind\":\"dev\",\"methods\":{\"calculateMonthlyPayment(uint256,uint256,uint256)\":{\"params\":{\"annualRateBps\":\"Annual nominal interest rate in basis points.\",\"months\":\"Number of monthly payments.\",\"principal\":\"Loan principal.\"},\"returns\":{\"monthlyPayment\":\"Fixed monthly installment.\",\"totalRepayment\":\"Total scheduled repayment over the loan term.\"}},\"compoundInterest(uint256,uint256,uint256)\":{\"returns\":{\"interestEarned\":\"The interest generated.\",\"totalAmount\":\"The final accumulated amount.\"}},\"futureValue(uint256,uint256,uint256)\":{\"returns\":{\"futureValue_\":\"The accumulated value after growth.\"}},\"presentValue(uint256,uint256,uint256)\":{\"returns\":{\"presentValue_\":\"The current discounted value.\"}},\"simpleInterest(uint256,uint256,uint256)\":{\"returns\":{\"interestEarned\":\"The interest generated.\",\"totalAmount\":\"The principal plus interest.\"}}},\"title\":\"ActuarialEngine\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"calculateMonthlyPayment(uint256,uint256,uint256)\":{\"notice\":\"Calculates the fixed monthly payment for a loan using         the annuity-immediate formula. Formula: PMT = P \\u00d7 i \\u00d7 (1 + i)^n       -------------------          (1 + i)^n - 1 This is mathematically equivalent to: PMT = P \\u00d7 i / (1 - (1 + i)^(-n))\"},\"compoundInterest(uint256,uint256,uint256)\":{\"notice\":\"Calculates compound interest.\"},\"futureValue(uint256,uint256,uint256)\":{\"notice\":\"Calculates future value using compound interest.\"},\"presentValue(uint256,uint256,uint256)\":{\"notice\":\"Calculates present value from a future value.\"},\"simpleInterest(uint256,uint256,uint256)\":{\"notice\":\"Calculates simple interest.\"}},\"notice\":\"Provides actuarial and financial mathematics calculations for CoopChain.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/ActuarialEngine.sol\":\"ActuarialEngine\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\"/home/maxwell/Blockchain/CoopChain/lib/op